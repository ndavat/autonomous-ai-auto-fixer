{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "agent": {
    "mode": "dry-run",
    "maxRetries": 3,
    "riskPolicy": "low-risk-only"
  },
  "vcs": {
    "primary": "azure-devops",
    "azureDevOps": {
      "orgUrl": "https://dev.azure.com/your-org",
      "project": "your-project"
    },
    "github": {
      "appId": null,
      "installationId": null
    }
  },
  "llm": {
    "provider": "github-copilot",
    "model": "auto",
    "temperature": 0.0,
    "maxTokens": 4096
  },
  "secrets": {
    "source": "environment",
    "vaultUrl": "https://your-actual-vault.vault.azure.net/",
    "tenantId": null,
    "githubTokenSecretName": "github-token"
  },
  "ingestion": {
    "sonarqube": {
      "url": null,
      "prioritizeBugs": true
    },
    "mend": {
      "enabled": true
    },
    "trivy": {
      "enabled": true
    }
  },
  "remediation": {
    "priorityOrder": [
      "BUG",
      "VULNERABILITY",
      "BLOCKER",
      "CRITICAL",
      "MAJOR",
      "HIGH"
    ],
    "approvalRequired": [
      "MAJOR",
      "HIGH"
    ],
    "contextLines": 50
  },
  "validation": {
    "linters": {
      "python": ["flake8", "black", "isort"],
      "javascript": ["eslint"],
      "java": ["checkstyle"]
    },
    "buildVerification": {
      "enabled": false
    }
  },
  "logging": {
    "level": "Information",
    "file": {
      "enabled": true,
      "path": "logs/autofixer-.log",
      "retentionDays": 30
    },
    "console": {
      "enabled": true
    }
  }
}
